---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Choose your language for the Token Economy for Vibe Coding course."
    />
    <title>Token Economy for Vibe Coding</title>
  </head>
  <body>
    <main class="shell">
      <section class="hero" aria-labelledby="page-title">
        <p class="eyebrow">TOKEN ECONOMY</p>
        <h1 id="page-title">Token Economy for Vibe Coding</h1>
        <p class="intro">
          Learn to complete coding tasks with maintained quality, understandable workflow, and reasonable consumption.
        </p>

        <div class="language-grid" aria-label="Choose a language">
          <a class="language-card" href={`${baseUrl}/en/`}>
            <span class="language-label">English</span>
            <span class="language-description">Read the course in English</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a class="language-card" href={`${baseUrl}/sv/`}>
            <span class="language-label">Svenska</span>
            <span class="language-description">Lär dig slutföra kodningsuppgifter med bibehållen kvalitet och rimlig förbrukning</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    min-width: 320px;
    background: #10151f;
    color: #f4f7fb;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
  }

  .shell {
    display: grid;
    min-height: 100vh;
    place-items: center;
    padding: 2rem;
    background:
      radial-gradient(circle at 15% 15%, rgba(83, 132, 255, 0.18), transparent 32rem),
      radial-gradient(circle at 85% 85%, rgba(91, 211, 179, 0.12), transparent 30rem),
      #10151f;
  }

  .hero {
    width: min(100%, 52rem);
    padding: clamp(2rem, 6vw, 5rem);
    border: 1px solid rgba(206, 219, 241, 0.16);
    border-radius: 1.5rem;
    background: rgba(23, 31, 45, 0.86);
    box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.28);
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: #79d6be;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  h1 {
    max-width: 14ch;
    margin: 0;
    color: #ffffff;
    font-size: clamp(2.4rem, 7vw, 4.8rem);
    line-height: 0.98;
    letter-spacing: -0.05em;
  }

  .intro {
    max-width: 36rem;
    margin: 1.5rem 0 0;
    color: #b9c5d8;
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.65;
  }

  .language-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .language-card {
    position: relative;
    display: flex;
    min-height: 9rem;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.45rem;
    padding: 1.4rem;
    border: 1px solid rgba(206, 219, 241, 0.18);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.04);
    color: #ffffff;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      background 160ms ease,
      transform 160ms ease;
  }

  .language-card:hover,
  .language-card:focus-visible {
    border-color: #79d6be;
    background: rgba(121, 214, 190, 0.1);
    transform: translateY(-0.2rem);
  }

  .language-card:focus-visible {
    outline: 3px solid rgba(121, 214, 190, 0.45);
    outline-offset: 3px;
  }

  .language-label {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .language-description {
    color: #b9c5d8;
    font-size: 0.92rem;
  }

  .arrow {
    position: absolute;
    top: 1.25rem;
    right: 1.35rem;
    color: #79d6be;
    font-size: 1.5rem;
  }

  @media (max-width: 36rem) {
    .shell {
      padding: 1rem;
    }

    .hero {
      padding: 2rem 1.25rem;
    }

    .language-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
